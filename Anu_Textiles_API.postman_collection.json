{
  "info": {
    "name": "Anu's Textiles API",
    "description": "Sales Order → Delivery Note → Sales Invoice flow",
    "_postman_id": "anu-textiles-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost/anu-s-textiles/backend/api/v1" },
    { "key": "token",    "value": "YOUR_JWT_TOKEN_HERE" },
    { "key": "so_id",    "value": "1" },
    { "key": "dn_id",    "value": "1" },
    { "key": "sale_id",  "value": "1" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('token', json.data.access_token);",
                  "  console.log('Token saved:', json.data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Sales Order",
      "item": [
        {
          "name": "Create Sales Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('so_id', json.data.id);",
                  "  console.log('SO ID saved:', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/sales_order.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"party_ledger_id\": 1,\n  \"order_date\": \"2026-03-19\",\n  \"expected_date\": \"2026-03-25\",\n  \"billing_address\": \"123 Main Street, Bangalore\",\n  \"shipping_address\": \"123 Main Street, Bangalore\",\n  \"narration\": \"Test Sales Order\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"item_name\": \"Cotton Fabric\",\n      \"ordered_qty\": 100,\n      \"unit_id\": 1,\n      \"rate\": 50.00,\n      \"discount_percent\": 0,\n      \"discount_amount\": 0,\n      \"tax_id\": 1,\n      \"tax_percent\": 5,\n      \"tax_amount\": 250.00,\n      \"amount\": 5250.00,\n      \"godown_id\": 1\n    },\n    {\n      \"item_id\": 2,\n      \"item_name\": \"Polyester Fabric\",\n      \"ordered_qty\": 50,\n      \"unit_id\": 1,\n      \"rate\": 80.00,\n      \"discount_percent\": 0,\n      \"discount_amount\": 0,\n      \"tax_id\": 1,\n      \"tax_percent\": 5,\n      \"tax_amount\": 200.00,\n      \"amount\": 4200.00,\n      \"godown_id\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get All Sales Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/sales_order.php?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "sales_order.php"],
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Pending Sales Orders for Party (Dropdown)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/sales_order.php?pending_for_party=1",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "sales_order.php"],
              "query": [
                { "key": "pending_for_party", "value": "1", "description": "Replace with actual party/ledger ID" }
              ]
            },
            "description": "Use this to populate the Sales Order dropdown when creating a Sales Invoice or Delivery Note. Returns only orders with pending_qty > 0."
          }
        },
        {
          "name": "Get Single Sales Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/sales_order.php?id={{so_id}}",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "sales_order.php"],
              "query": [{ "key": "id", "value": "{{so_id}}" }]
            },
            "description": "Returns full order with items (ordered_qty / billed_qty / delivered_qty / pending_qty) and linked Sales Invoices + Delivery Notes."
          }
        },
        {
          "name": "Get Pending Orders Only (List)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/sales_order.php?pending_only=true",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "sales_order.php"],
              "query": [{ "key": "pending_only", "value": "true" }]
            }
          }
        },
        {
          "name": "Update Sales Order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/sales_order.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{so_id}},\n  \"expected_date\": \"2026-03-30\",\n  \"narration\": \"Updated narration\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"item_name\": \"Cotton Fabric\",\n      \"ordered_qty\": 120,\n      \"unit_id\": 1,\n      \"rate\": 50.00,\n      \"discount_amount\": 0,\n      \"tax_id\": 1,\n      \"tax_percent\": 5,\n      \"tax_amount\": 300.00,\n      \"amount\": 6300.00\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Cancel Sales Order",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/sales_order.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{so_id}}\n}"
            },
            "description": "Will fail if any qty has been billed or delivered."
          }
        }
      ]
    },

    {
      "name": "Delivery Note",
      "item": [
        {
          "name": "Create Delivery Note (linked to SO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('dn_id', json.data.id);",
                  "  console.log('DN ID saved:', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/delivery_note.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"party_ledger_id\": 1,\n  \"order_id\": {{so_id}},\n  \"voucher_date\": \"2026-03-19\",\n  \"billing_name\": \"Customer Name\",\n  \"billing_address\": \"123 Main Street, Bangalore\",\n  \"billing_state\": \"Karnataka\",\n  \"vehicle_no\": \"KA01AB1234\",\n  \"transporter_name\": \"Fast Logistics\",\n  \"narration\": \"Partial delivery against SO\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"item_name\": \"Cotton Fabric\",\n      \"quantity\": 60,\n      \"unit_id\": 1,\n      \"rate\": 50.00,\n      \"godown_id\": 1,\n      \"order_item_id\": 1,\n      \"description\": \"Batch 1 delivery\"\n    }\n  ]\n}"
            },
            "description": "order_item_id comes from the items returned by ?pending_for_party. Delivering 60 out of 100 ordered."
          }
        },
        {
          "name": "Get All Delivery Notes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/delivery_note.php?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "delivery_note.php"],
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Delivery Notes by Party",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/delivery_note.php?party_id=1",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "delivery_note.php"],
              "query": [{ "key": "party_id", "value": "1" }]
            }
          }
        },
        {
          "name": "Get Delivery Notes by Sales Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/delivery_note.php?order_id={{so_id}}",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "delivery_note.php"],
              "query": [{ "key": "order_id", "value": "{{so_id}}" }]
            }
          }
        },
        {
          "name": "Get Single Delivery Note",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/delivery_note.php?id={{dn_id}}",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "delivery_note.php"],
              "query": [{ "key": "id", "value": "{{dn_id}}" }]
            }
          }
        },
        {
          "name": "Update Delivery Note",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/delivery_note.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{dn_id}},\n  \"party_ledger_id\": 1,\n  \"order_id\": {{so_id}},\n  \"voucher_date\": \"2026-03-19\",\n  \"vehicle_no\": \"KA01CD5678\",\n  \"narration\": \"Updated delivery note\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"item_name\": \"Cotton Fabric\",\n      \"quantity\": 70,\n      \"unit_id\": 1,\n      \"rate\": 50.00,\n      \"order_item_id\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Cancel Delivery Note",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/delivery_note.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{dn_id}}\n}"
            },
            "description": "Reverses delivered_qty on order_items. Sales Order pending_qty is restored."
          }
        }
      ]
    },

    {
      "name": "Sales Invoice (linked to SO)",
      "item": [
        {
          "name": "Create Sales Invoice linked to Sales Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('sale_id', json.data.id);",
                  "  console.log('Sale ID saved:', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/sales.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"party_ledger_id\": 1,\n  \"order_id\": {{so_id}},\n  \"voucher_date\": \"2026-03-19\",\n  \"company_state\": \"Karnataka\",\n  \"party_state\": \"Karnataka\",\n  \"narration\": \"Invoice against Sales Order\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"item_name\": \"Cotton Fabric\",\n      \"order_item_id\": 1,\n      \"quantity\": 50,\n      \"unit_id\": 1,\n      \"rate\": 50.00,\n      \"discount_percent\": 0,\n      \"discount_amount\": 0,\n      \"tax_id\": 1,\n      \"tax_percent\": 5,\n      \"godown_id\": 1\n    }\n  ]\n}",
              "description": "order_id links invoice to SO. order_item_id on each item reduces pending_qty. Billing 50 of 100 ordered → SO shows 50 remaining."
            }
          }
        },
        {
          "name": "Cancel Sales Invoice (reverses SO qty)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/sales.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{sale_id}}\n}"
            },
            "description": "Cancelling reverses billed_qty on order_items → SO pending_qty is restored."
          }
        }
      ]
    },

    {
      "name": "Typical Flow (Run in order)",
      "item": [
        {
          "name": "STEP 1 — Create Sales Order (100 qty)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/sales_order.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"party_ledger_id\": 1,\n  \"order_date\": \"2026-03-19\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"item_name\": \"Cotton Fabric\",\n      \"ordered_qty\": 100,\n      \"unit_id\": 1,\n      \"rate\": 50.00,\n      \"tax_percent\": 5,\n      \"tax_amount\": 250,\n      \"amount\": 5250\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "STEP 2 — Check pending orders for party",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/sales_order.php?pending_for_party=1",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "sales_order.php"],
              "query": [{ "key": "pending_for_party", "value": "1" }]
            },
            "description": "Use response items[].id as order_item_id in next requests"
          }
        },
        {
          "name": "STEP 3a — Deliver 60 qty (Delivery Note)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/delivery_note.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"party_ledger_id\": 1,\n  \"order_id\": {{so_id}},\n  \"voucher_date\": \"2026-03-19\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"item_name\": \"Cotton Fabric\",\n      \"quantity\": 60,\n      \"unit_id\": 1,\n      \"rate\": 50.00,\n      \"order_item_id\": 1\n    }\n  ]\n}",
              "description": "After this: delivered_qty=60, pending_qty=40"
            }
          }
        },
        {
          "name": "STEP 3b — Bill 40 qty (Sales Invoice)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/sales.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"party_ledger_id\": 1,\n  \"order_id\": {{so_id}},\n  \"voucher_date\": \"2026-03-20\",\n  \"company_state\": \"Karnataka\",\n  \"party_state\": \"Karnataka\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"item_name\": \"Cotton Fabric\",\n      \"order_item_id\": 1,\n      \"quantity\": 40,\n      \"unit_id\": 1,\n      \"rate\": 50.00,\n      \"tax_percent\": 5\n    }\n  ]\n}",
              "description": "After this: billed_qty=40, pending_qty=0 → SO status=Completed"
            }
          }
        },
        {
          "name": "STEP 4 — Verify SO is Completed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/vouchers/sales_order.php?id={{so_id}}",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "sales_order.php"],
              "query": [{ "key": "id", "value": "{{so_id}}" }]
            },
            "description": "Should show status=Completed, pending_qty=0, billed_qty=40, delivered_qty=60"
          }
        },
        {
          "name": "STEP 5 — Cancel Sales Invoice (qty restored)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/vouchers/sales.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{sale_id}}\n}",
              "description": "After cancel: billed_qty=0, pending_qty=40, SO status=Partial"
            }
          }
        }
      ]
    }

  ]
}
