      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData?.data?.tokens?.accessToken) pm.environment.set('ACCESS_TOKEN', jsonData.data.tokens.accessToken);",
                  "if (jsonData?.data?.tokens?.refreshToken) pm.environment.set('REFRESH_TOKEN', jsonData.data.tokens.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@anutextiles.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/login.php",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "login.php"]
            }
          },
          "response": []
        },
