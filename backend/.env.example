# Application Settings
APP_ENV=local
APP_DEBUG=false

# Database Configuration
DB_HOST=localhost
DB_NAME=anu_textiles
DB_USER=root
DB_PASS=your_database_password

# JWT Configuration
JWT_SECRET=your-generated-jwt-secret-min-64-chars-run-php-generate-secret.php
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000

# Email Configuration (optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@anutextiles.com
MAIL_FROM_NAME="Saas Books"

# App Configuration
APP_URL=http://localhost
TIMEZONE=Asia/Kolkata

# E-Way Bill (CharteredInfo) Configuration
EWB_BASE_URL=https://einvapi.charteredinfo.com/v1.03/dec/ewayapi
EWB_AUTH_URL=https://einvapi.charteredinfo.com/v1.03/dec/auth
EWB_ASP_ID=your_asp_id
EWB_ASP_PASSWORD=your_asp_password
EWB_TIMEOUT=45
